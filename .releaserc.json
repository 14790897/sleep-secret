{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/set_version.sh ${nextRelease.version} && bash scripts/build_release_apk.sh"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["app/pubspec.yaml"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "app/build/app/outputs/flutter-apk/app-arm64-v8a-release.apk",
            "label": "Android · arm64-v8a（现代手机装这个）"
          },
          {
            "path": "app/build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk",
            "label": "Android · armeabi-v7a（较老的 32 位设备）"
          },
          {
            "path": "app/build/app/outputs/flutter-apk/app-x86_64-release.apk",
            "label": "Android · x86_64（模拟器用）"
          }
        ]
      }
    ]
  ]
}
